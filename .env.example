# Modelo de configuração. Copie para .env e ajuste. Nunca coloque segredos reais aqui.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Banco local do docker-compose (npm run db:up). Só para desenvolvimento.
# Migrações usam o papel dono das tabelas.
DATABASE_MIGRATION_URL=postgresql://nexo:nexo@localhost:5432/nexo
# A aplicação usa o papel nexo_app, sem superusuário e sem BYPASSRLS (SEGURANCA.md).
# Troque a senha local se quiser; `npm run db:setup-local -w @nexo/api` aplica a senha daqui.
DATABASE_URL=postgresql://nexo_app:troque-esta-senha-local@localhost:5432/nexo

# Endereço do painel (CORS).
WEB_ORIGIN=http://localhost:5173

# WhatsApp Cloud API (oficial da Meta). Deixe vazio até a conta da Meta estar liberada:
# sem o App Secret o webhook recusa tudo; sem o token as respostas ficam só no histórico.
# Os valores reais ficam só no seu .env (nunca no git).
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=

# Processa a fila de mensagens neste processo (true/false).
RUN_WORKER=true
