# Modelo de configuração. Copie para .env e ajuste. Nunca coloque segredos reais aqui.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Banco local do docker-compose (npm run db:up). Só para desenvolvimento.
# Migrações usam o papel dono das tabelas.
DATABASE_MIGRATION_URL=postgresql://nexo:nexo@localhost:5432/nexo
# A aplicação usa o papel nexo_app, sem superusuário e sem BYPASSRLS (SEGURANCA.md).
# Troque a senha local se quiser; `npm run db:setup-local -w @nexo/api` aplica a senha daqui.
DATABASE_URL=postgresql://nexo_app:troque-esta-senha-local@localhost:5432/nexo

# Endereço do painel (CORS).
WEB_ORIGIN=http://localhost:5173

# WhatsApp Cloud API (oficial da Meta). Deixe vazio até a conta da Meta estar liberada:
# sem o App Secret o webhook recusa tudo; sem o token as respostas ficam só no histórico.
# Os valores reais ficam só no seu .env (nunca no git).
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=

# Produção num processo só: pasta do build do painel (apps/web/dist). Com ela, a API fica em /api.
# Deixe vazio no desenvolvimento (o Vite serve o painel). A imagem Docker já define.
WEB_DIST_DIR=

# Cadastro pelo site ("Criar conta"), com confirmação de e-mail. Desligado por padrão.
# No desenvolvimento os e-mails não saem: o link aparece no log da API.
SIGNUP_ENABLED=true

# Processa a fila de mensagens neste processo (true/false).
RUN_WORKER=true

# Chave da criptografia de campo (2FA do admin nexo). 32 bytes em base64. Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=

# Proxies confiáveis na frente da API (0 no localhost).
TRUST_PROXY=0

# Avisos em tempo real entre processos (API, worker e simulador) pelo Postgres.
REALTIME_CROSS_PROCESS=true

# Simulador do terminal: negócio e telefone fictício usados (o seed mostra o ID).
# SIMULATOR_TENANT_ID=
# SIMULATOR_PHONE=5500999990001
