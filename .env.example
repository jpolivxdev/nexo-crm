# Modelo de configuração. Copie para .env e ajuste. Nunca coloque segredos reais aqui.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Banco local do docker-compose (npm run db:up). Só para desenvolvimento.
# Na E2 a aplicação passa a usar um papel próprio, sem superusuário.
DATABASE_URL=postgresql://nexo:nexo@localhost:5432/nexo

# Endereço do painel (CORS).
WEB_ORIGIN=http://localhost:5173
